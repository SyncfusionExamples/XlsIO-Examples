<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Syncfusion.XlsIO.Net.Core" Version="35.1.41" />
    <PackageReference Include="Aspose.Cells" Version="26.10.0" />
    <PackageReference Include="DevExpress.Document.Processor" Version="26.1.5" />
    <PackageReference Include="DevExpress.Drawing.Skia" Version="26.1.5" />
    <PackageReference Include="IronXL.Excel" Version="2026.10.5" />
    <PackageReference Include="GemBox.Spreadsheet" Version="2026.10.116" />
  </ItemGroup>

</Project>
