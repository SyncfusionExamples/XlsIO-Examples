<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <StartupObject>BenchmarkHost</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Syncfusion.XlsIO.Net.Core" Version="35.1.41" />
    <PackageReference Include="Syncfusion.XlsIORenderer.Net.Core" Version="35.1.41" />
    <PackageReference Include="Syncfusion.Pdf.Net.Core" Version="35.1.41" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.151.0" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.1.1" />
    <PackageReference Include="Aspose.Cells" Version="26.10.0" />
    <PackageReference Include="DevExpress.Document.Processor" Version="26.1.5" />
    <PackageReference Include="DevExpress.Drawing.Skia" Version="26.1.5" />
    <PackageReference Include="DevExpress.Pdf.SkiaRenderer" Version="26.1.5" />
    <PackageReference Include="IronXL.Excel" Version="2026.10.5" />
    <PackageReference Include="GemBox.Spreadsheet" Version="2026.10.116" />
  </ItemGroup>

</Project>
