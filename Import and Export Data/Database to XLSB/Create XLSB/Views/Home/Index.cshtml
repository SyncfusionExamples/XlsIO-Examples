@{
    Layout = null;
    ViewBag.Title = "Database to XLSB Export";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: "Segoe UI", Tahoma, Arial, sans-serif;
            background: #f3f4f6;
        }
        .card {
            background: #fff;
            width: 100%;
            max-width: 480px;
            padding: 32px;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            text-align: center;
        }
        h1 { margin: 0 0 12px; font-size: 24px; color: #222; }
        p  { margin: 0 0 24px; font-size: 14px; line-height: 1.6; color: #555; }
        .btn {
            padding: 12px 28px;
            border: 0;
            border-radius: 4px;
            background: #0066cc;
            color: #fff;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
        }
        .btn:hover { background: #0052a3; }
        .error {
            margin-bottom: 20px;
            padding: 10px 14px;
            border-left: 4px solid #d32f2f;
            background: #fdecea;
            color: #b71c1c;
            font-size: 14px;
            text-align: left;
        }
    </style>
</head>
<body>
    <div class="card">
        <h1>Database to XLSB Export</h1>
        <p>
            Reads the Products table from an Access (.mdb) database into a DataTable, imports it into an
            Excel worksheet using Syncfusion XlsIO, and downloads it as ProductsExport.xlsb.
        </p>

        @if (!string.IsNullOrEmpty(ViewBag.Message))
        {
            <div class="error">@ViewBag.Message</div>
        }

        @using (Html.BeginForm("ExportToXlsb", "Home", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn">Export to XLSB</button>
        }
    </div>
</body>
</html>
