<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AgentChatApp</AssemblyName>
    <RootNamespace>AgentChatApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="*" />
    <PackageReference Include="Syncfusion.DocumentSDK.AI.AgentTools" Version="*" />
	  <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="*" />
  </ItemGroup>

  <!-- Copy Data folder and all its contents to output directory during build and publish -->
	<ItemGroup>
		<None Update="Data\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

</Project>
