<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <StartupObject>BenchmarkHost</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Syncfusion.XlsIO.Net.Core" Version="35.1.41" />
    <PackageReference Include="Syncfusion.XlsIORenderer.Net.Core" Version="35.1.41" />
    <PackageReference Include="Syncfusion.Pdf.Net.Core" Version="35.1.41" />
  </ItemGroup>

</Project>
